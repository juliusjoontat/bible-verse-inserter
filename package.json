{
  "name": "bible-verse-inserter",
  "version": "2.0.0",
  "description": "Multi-browser Bible extension with API-based backend on Supabase",
  "scripts": {
    "dev": "npm run build:dev",
    "build": "npm run build:chrome && npm run build:firefox && npm run build:edge && npm run build:opera",
    "build:dev": "node scripts/build.js --browser chrome --dev",
    "build:chrome": "node scripts/build.js --browser chrome",
    "build:firefox": "node scripts/build.js --browser firefox",
    "build:edge": "node scripts/build.js --browser edge",
    "build:opera": "node scripts/build.js --browser opera",
    "package": "npm run build && node scripts/package.js",
    "test": "jest",
    "lint": "eslint src/",
    "import:bibles": "node scripts/import-bibles.js",
    "setup:supabase": "node scripts/setup-supabase.js"
  },
  "dependencies": {
    "webextension-polyfill": "^0.10.0"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "node-fetch": "^2.7.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "keywords": [
    "bible",
    "extension",
    "chrome",
    "firefox",
    "edge",
    "verses",
    "supabase",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT"
}
